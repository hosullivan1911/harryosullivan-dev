---
import Layout from '../layouts/Layout.astro';

const years = [
	{ year: '2023', entries: [
		{ title: 'Operational geology foundation', description: 'Learned Metallurgical, Geophysics, Geotech, and RC logging workflows using Acquire, Leapfrog, ArcGIS Pro, and Tableau.' },
		{
			title: 'End-of-hole chart and assay review tool',
			sections: [
				{
					subtitle: 'Problem',
					description: 'The metallurgical stakeholders wanted core photography presented alongside assays and hole logging for every completed hole.'
				},
				{
					subtitle: 'Solution',
					description: 'Built an automated tool for producing end-of-hole charts and reviewing assay information. Incorporates and aligns photos, logging, assays and geophysics while accounting for differences between RC and diamond RLs.'
				},
				{
					subtitle: 'Outcome',
					description: 'Became the standard PDF output attached to completed-hole notifications, giving metallurgical stakeholders a consistent view of photography, logging, assays and geophysics. Approximately 4 holes are completed a week.'
				}
			]
		},
		{
			title: 'Downhole gamma and stratigraphic correlation calculator',
			sections: [
				{
					subtitle: 'Problem',
					description: 'A common part of the diamond QAQC process is validating logging intervals against a standard using the downhole gamma trace. This is time-consuming and can be very subjective.'
				},
				{
					subtitle: 'Solution',
					description: 'Used a simple regression model to compare the raw gamma trace against a converted standard, find the smallest error margin and validate that the standard boundaries aligned with the logging.'
				},
				{
					subtitle: 'Outcome',
					description: 'The standard was too noisy, and the gamma peak indicative of shale varied too much in scale between logs.'
				}
			]
		},
		{ title: 'Historical disturbance and rehabilitation assessment', description: 'Combined database records, maps and aerial imagery to assess historical drilling disturbance and rehabilitation status.' },
		{
			title: 'Drill-Program cost forecasting model',
			sections: [
				{
					subtitle: 'Problem',
					description: 'CAPEX projects are billed to stakeholders internally; we had no way to estimate the cost of a program.'
				},
				{
					subtitle: 'Solution',
					description: 'Analysed historical drilling data and built a model that estimates drilling, personnel, flights, accommodation, fuel, earthworks and car or van rental costs relevant to exploration programs, while accounting for potential delays.'
				},
				{
					subtitle: 'Outcome',
					description: 'The Excel model was used for the remainder of the financial year before being superseded by an Anaplan-based tool.'
				}
			]
		}
	] },
	{ year: '2024', entries: [
		{
			title: 'Enterprise geological QAQC automation platform',
			sections: [
				{
					subtitle: 'Problem',
					description: 'QAQC of any Geological workflow is highly subjective, I noticed the quality of the data we provided our stakeholders with varied drastically.'
				},
				{
					subtitle: 'Solution',
					description: 'I consulted with our Orebody Specialist to compose 20 strict logging rules to apply to our data, a list of non-negotiable requirements of our data. I initally built an Excel Macro that would apply these rules to a CSV upload of the logging, and highlighted probelems with the logged data. This eventually transitioned to being a PowerBI report reading our data directly from Snowflake.'
				},
				{
					subtitle: 'Outcome',
					description: 'The tool was well received, and is used to date. Has grown to become important part of our Senior Geologist's End-Of-Scope reporting.'
				}
			]
		},
		{ title: 'Sonic recovery and productivity analysis', description: 'Analysed recovery and production by geology, stratigraphy, shift, drilling method and ground conditions to distinguish operational performance from geological difficulty.' },
		{ title: 'Drilling-risk workflow', description: 'Created a spatial assessment workflow so planned holes could be checked against known underground hazards, specifically lost GET and Cavities.' },
		{ title: 'Density-hole relocation analysis', description: 'Combined geological, assay and spatial constraints to identify technically suitable alternative drilling locations.' },
		{ title: 'Geological data integration into an enterprise platform', description: 'Worked with data teams to expose drilling, logging and operational information in Snowflake.' },
		{ title: 'Dynamic rig-scheduling tool', description: 'Developed and implemented scheduling concept combining project priorities, expected drilling durations and available rig capacity.' },
		{
			title: 'PLOD and Invoice Reconcilliation Tool',
			sections: [
				{
					subtitle: 'Problem',
					description: 'I was tasked with comparing the drilling invoices to the submitted PLOD's (timesheets) each month, and then asked to recommend for the invoice to either be accepted, or not. This was a time consuming process and prone to Human Error.'
				},
				{
					subtitle: 'Solution',
					description: 'I built a Python script that could understand the format of each drill contractors invoice, and automatically reconcile the claim against the accepted PLOD data available through Coreplan.'
				},
				{
					subtitle: 'Outcome',
					description: 'I used the tool for the duration of my time in the team, and it was used once I moved on. It has now been replaced by a more sophistacted integrated tool. However, issues still remain as the source of the PLOD data is in itself dependant on Field Teams accepting PLOD costs, which is often done so incorrectly.'
				}
			]
		},
		{ title: 'ArcGIS pad-and-sump automation', description: 'Built an ArcGIS Pro Python toolbox that automated drilling pad and sump layouts and reduced repetitive GIS preparation. Generated the .shp files required for the Trimble earthworks packages used ad the time.' },
		{ title: 'Live project-completion reporting', description: 'Developed a reporting concept that progressively populated project-completion information from live operational and QAQC data.' },
		{ title: 'Tableau to PowerBI transition', description: 'Contributed to the department wide transition from Tableau to PowerBI by building out approximately 20 Diamond Drilling reports.' }
	] },
	{ year: '2025', entries: [
		{ title: 'AI drill-core photo classification', description: 'Coordinated an AI project to recognise and classify information from core photographs, including the creation of review datasets and a validation workflow.' },
		{ title: 'Core-photo metadata automation', description: 'Developed a workflow concept for extracting depth and related metadata from core photographs to reduce manual indexing and improve searchability.' },
		{ title: 'Geoscience AI use-case portfolio', description: 'Identified and developed practical AI use cases across drilling, geology, earthworks, imagery and operational data.' },
		{ title: 'Terrain and drill-access analytics', description: 'Developed methods for classifying terrain and slope conditions to support drilling access, pad design and earthworks planning.' },
		{ title: 'Geospatial planning automation suite', description: 'Developed GIS scripts that combined planning datasets, proposed drillholes and spatial assignment information.' },
		{ title: 'Drillhole orientation optimiser', description: 'Built a Python toolbox for optimising drillhole orientations and released it for operational testing.' },
		{ title: 'Equipment telemetry for earthworks analytics', description: 'Assessed whether heavy-equipment telemetry could improve earthworks forecasting and equipment-performance analysis.' },
		{ title: 'Spatial-boundary breach prediction', description: 'Developed a machine-learning prototype using rolling behavioural features to identify equipment at elevated risk of crossing an approved work boundary.' }
	] },
	{ year: '2026', entries: [
		{ title: 'AI-supported drill-pad optimiser', description: 'Developed an AI-supported approach to drill-pad orientation and optimisation using geological, terrain and earthworks inputs.' },
		{ title: 'Planning-to-execution integration', description: 'Explored how pad-optimisation outputs could connect with operational planning and machine-guidance systems.' },
		{ title: 'Agentic density-hole planner', description: 'Developed an agentic AI workflow for assisting with density-hole program design while retaining deterministic geological and operational checks.' },
		{ title: 'RC twin scoring model', description: 'Developed a traceable scoring concept for assessing possible RC twin holes and supporting density planning.' },
		{ title: 'Geophysics AI program designer', description: 'Built an agentic AI application that queried governed data, applied spatial and geological checks, and proposed candidate drilling programs for user review.' },
		{ title: 'AI governance and delivery framework', description: 'Established a structured portfolio of geoscience AI projects with clear ownership, testing and validation responsibilities.' },
		{ title: 'Natural-language geological analytics', description: 'Developed a semantic layer and conversational analyst capable of answering natural-language questions across drilling, geology and QAQC information.' },
		{ title: 'Conversational operational-data interface', description: 'Helped develop a governed conversational interface that allowed users to interrogate operational and geological data without manually searching multiple reports and systems.' },
		{ title: 'Operational-intelligence workflow', description: 'Combined activity, production, equipment and operator information to investigate operational performance and distinguish between allocation, task and equipment-related constraints.' },
		{ title: 'Governed cross-system data integration', description: 'Coordinated internal and external technical teams to establish a governed proof of concept for sharing operational data between systems.' },
		{ title: 'Multimodal geological QAQC', description: 'Developed a concept combining geological logging, structured QAQC information, comparison holes and core imagery within a conversational analysis workflow.' },
		{ title: 'Rapid internal application pilot', description: 'Participated in a pilot to test rapid development and deployment of lightweight internal applications against governed geoscience data.' },
		{ title: 'Real-time geological data-quality notifications', description: 'Built event-driven monitoring that identifies bespoke data-quality conditions and sends notifications within seconds of new records entering the governed database.' },
		{ title: 'AI-summarised notification agents', description: 'Extended the real-time notification framework into an end-to-end agent workflow: governed data events are converted into structured messages, summarised through an AI model, delivered to the intended user in Teams, and recorded in an audit trail with the delivery time and recipient.' },
		{ title: 'WhatsApp operational fault-pattern analysis', description: 'Analysed WhatsApp support conversations alongside equipment telemetry to identify recurring fault patterns, recognise early indicators of hardware and GNSS failure, and define practical automated monitoring rules.' }
	] }
];
---

<Layout
	title="Projects to date"
	description="A selected and anonymised record of technical, operational, geoscience AI, GIS, analytics and mining technology projects."
>
	<div class="site">
		<header>
			<nav>
				<a href="/">home</a>
				<span>/</span>
				<a href="/about">about</a>
				<span>/</span>
				<a href="/projects-to-date" aria-current="page">projects to date</a>
			</nav>
		</header>

		<main>
			<section class="intro">
				<h1>Projects to date</h1>
				<p>A selected and anonymised record of technical, operational and product work.</p>
			</section>

			<section class="timeline">
				{years.map((group) => (
					<section class="year-block">
						<h2>{group.year}</h2>
						<div class="year-entries">
							{group.entries.map((entry) => (
								<article class="project-entry">
									<div class="marker" aria-hidden="true"></div>
									<div>
										<h3>{entry.title}</h3>
										{'sections' in entry ? (
											entry.sections.map((section) => (
												<div class="project-section">
													<h4>{section.subtitle}</h4>
													<p>{section.description}</p>
												</div>
											))
										) : (
											<p>{entry.description}</p>
										)}
									</div>
								</article>
							))}
						</div>
					</section>
				))}
			</section>
		</main>

		<footer>
			<a href="/">← back home</a>
		</footer>
	</div>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) {
		background: #000;
		color: #fff;
		font-family: "Courier New", Courier, monospace;
	}
	:global(body) { margin: 0; background: #000; }
	:global(a) {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.site {
		width: min(780px, calc(100% - 40px));
		min-height: 100vh;
		margin: 0 auto;
		padding: 24px 0 32px;
	}
	header {
		padding-bottom: 14px;
		border-bottom: 1px dashed #777;
	}
	nav {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		font-size: 15px;
	}
	main { padding: 48px 0; }
	.intro {
		padding-bottom: 34px;
		border-bottom: 1px dashed #777;
	}
	h1 { margin: 0 0 12px; font-size: 18px; }
	.intro p {
		margin: 0;
		color: #bbb;
		font-size: 15px;
		line-height: 1.6;
	}
	.timeline { padding-top: 42px; }
	.year-block {
		display: grid;
		grid-template-columns: 90px 1fr;
		gap: 28px;
		padding: 0 0 54px;
	}
	h2 {
		position: sticky;
		top: 24px;
		align-self: start;
		margin: 0;
		font-size: 16px;
	}
	.year-entries { position: relative; }
	.year-entries::before {
		content: "";
		position: absolute;
		top: 8px;
		bottom: 8px;
		left: 4px;
		border-left: 1px dashed #555;
	}
	.project-entry {
		position: relative;
		display: grid;
		grid-template-columns: 18px 1fr;
		gap: 14px;
		padding-bottom: 28px;
	}
	.marker {
		position: relative;
		z-index: 1;
		width: 9px;
		height: 9px;
		margin-top: 5px;
		background: #000;
		border: 1px solid #aaa;
		border-radius: 50%;
	}
	h3 {
		margin: 0 0 7px;
		font-size: 15px;
		line-height: 1.45;
	}
	.project-section {
		margin: 0 0 14px;
	}
	.project-section:first-of-type {
		margin-top: 14px;
	}
	.project-section:last-child {
		margin-bottom: 0;
	}
	.project-section h4 {
		margin: 0 0 4px;
		color: #ddd;
		font-size: 14px;
		font-weight: bold;
		line-height: 1.45;
	}
	.project-entry p {
		margin: 0;
		color: #aaa;
		font-size: 14px;
		line-height: 1.65;
	}
	footer {
		padding-top: 18px;
		border-top: 1px dashed #777;
		font-size: 15px;
	}
	@media (max-width: 620px) {
		.site { width: min(100% - 24px, 780px); }
		nav { justify-content: flex-start; flex-wrap: wrap; }
		.year-block { grid-template-columns: 1fr; gap: 18px; }
		h2 { position: static; }
	}
</style>
