---
import Layout from '../layouts/Layout.astro';

const years = [
	{ year: '2023', entries: [
		{ title: 'Operational geology foundation', description: 'Learned metallurgical, geophysical, geotechnical and RC logging workflows using Acquire, Leapfrog, ArcGIS Pro and Tableau.' },
		{
			title: 'End-of-hole chart and assay review tool',
			sections: [
				{
					subtitle: 'Problem',
					description: 'Metallurgical stakeholders needed core photography, assays and geological logging presented together for every completed hole.'
				},
				{
					subtitle: 'Solution',
					description: 'Built a tool aligning photography, logging, assays and geophysics while accounting for differences between RC and diamond holes.'
				},
				{
					subtitle: 'Outcome',
					description: 'Became the standard PDF attached to completed-hole notifications, supporting approximately four completed holes each week.'
				}
			]
		},
		{
			title: 'Downhole gamma and stratigraphic correlation calculator',
			sections: [
				{
					subtitle: 'Problem',
					description: 'Validating diamond logging intervals against a standard using downhole gamma traces was slow and subjective.'
				},
				{
					subtitle: 'Solution',
					description: 'Built a regression model comparing raw gamma traces with a converted standard to test whether geological boundaries aligned.'
				},
				{
					subtitle: 'Outcome',
					description: 'Testing showed the standard was too noisy and gamma peaks varied too greatly between logs for reliable automation.'
				}
			]
		},
		{ title: 'Historical disturbance and rehabilitation assessment', description: 'Combined database records, maps and aerial imagery to assess historical drilling disturbance and rehabilitation status.' },
		{
			title: 'Drill-program cost forecasting model',
			sections: [
				{
					subtitle: 'Problem',
					description: 'Internally billed CAPEX drilling programs lacked a reliable method for forecasting total cost.'
				},
				{
					subtitle: 'Solution',
					description: 'Built an Excel model using historical data to estimate drilling, personnel, travel, accommodation, vehicle and earthworks costs, including delays.'
				},
				{
					subtitle: 'Outcome',
					description: 'Used for the remainder of the financial year before being superseded by an Anaplan-based tool.'
				}
			]
		}
	] },
	{ year: '2024', entries: [
		{
			title: 'Enterprise geological QAQC automation platform',
			sections: [
				{
					subtitle: 'Problem',
					description: 'Subjective QAQC produced inconsistent geological data quality for downstream stakeholders.'
				},
				{
					subtitle: 'Solution',
					description: 'Defined 20 non-negotiable logging rules with an orebody specialist, then progressed the checker from an Excel macro to Power BI and Snowflake.'
				},
				{
					subtitle: 'Outcome',
					description: 'The tool remains in use and now supports senior geologists’ end-of-scope reporting.'
				}
			]
		},
		{ title: 'Sonic recovery and productivity analysis', description: 'Analysed recovery and production by geology, stratigraphy, shift, drilling method and ground conditions to distinguish operational performance from geological difficulty.' },
		{ title: 'Drilling-risk workflow', description: 'Created a spatial assessment workflow so planned holes could be checked against known underground hazards, specifically lost GET and cavities.' },
		{ title: 'Density-hole relocation analysis', description: 'Combined geological, assay and spatial constraints to identify technically suitable alternative drilling locations.' },
		{ title: 'Geological data integration into an enterprise platform', description: 'Worked with data teams to expose drilling, logging and operational information in Snowflake.' },
		{ title: 'Dynamic rig-scheduling tool', description: 'Developed and implemented a scheduling concept combining project priorities, expected drilling durations and available rig capacity.' },
		{
			title: 'PLOD and invoice reconciliation tool',
			sections: [
				{
					subtitle: 'Problem',
					description: 'Monthly drilling invoices required manual comparison with submitted PLOD timesheets, creating a slow and error-prone approval process.'
				},
				{
					subtitle: 'Solution',
					description: 'Built a Python script that interpreted contractor invoice formats and reconciled claims against accepted CorePlan PLOD data.'
				},
				{
					subtitle: 'Outcome',
					description: 'The tool remained in use after I left the team and was later replaced by a more sophisticated integrated system.'
				}
			]
		},
		{ title: 'ArcGIS pad-and-sump automation', description: 'Built an ArcGIS Pro Python toolbox that automated drilling pad and sump layouts and reduced repetitive GIS preparation. Generated the shapefiles required for the Trimble earthworks packages used at the time.' },
		{ title: 'Live project-completion reporting', description: 'Developed a reporting concept that progressively populated project-completion information from live operational and QAQC data.' },
		{ title: 'Tableau-to-Power BI transition', description: 'Contributed to the department-wide transition from Tableau to Power BI by building approximately 20 diamond-drilling reports.' }
	] },
	{
		year: '2025',
		milestones: [
			{
				date: 'March 2025',
				title: 'Systems Specialist Geologist secondment',
				description: 'Moved from field-based diamond drilling into a systems-focused secondment spanning geological data, automation, operational technology and AI.'
			},
			{
				date: 'September 2025',
				title: 'Permanent appointment offered',
				description: 'Following the secondment, Fortescue formalised the work into a permanent Systems Geologist role and offered it to me.'
			}
		],
		entries: [
			{
				title: 'GuidEx fleet deployment and operational intelligence',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Fortescue needed more accurate field-asset visibility and operator boundary warnings. When I took over GuidEx, only 10 of 65 machines had hardware installed.'
					},
					{
						subtitle: 'Solution',
						description: 'Led deployment across five sites, four contractors and approximately 300 users; built Snowflake ingestion, GIS and analytics workflows, plus ServiceNow-managed support.'
					},
					{
						subtitle: 'Outcome',
						description: 'All 65 assets adopted GuidEx. Its data improved operational visibility and enabled material cost recovery through reconciliation with contractor-charged timesheets.'
					}
				]
			},
			{
				title: 'AI-enabled drill-core image cataloguing',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Approximately 40,000 core photographs sat in a slow OneDrive archive, with key metadata visible only as writing on the photographed trays.'
					},
					{
						subtitle: 'Solution',
						description: 'Independently built an automated catalogue workflow using cropping, OCR testing and an OpenAI-powered Python node to extract and structure tray metadata.'
					},
					{
						subtitle: 'Outcome',
						description: 'Approximately 20,000 images are catalogued at 93% extraction accuracy. New images enter automatically, with future metadata integration planned for Acquire.'
					}
				]
			},
			{ title: 'Geoscience AI use-case portfolio', description: 'Identified and developed practical AI use cases across drilling, geology, earthworks, imagery and operational data.' },
			{ title: 'Terrain and drill-access analytics', description: 'Developed methods for classifying terrain and slope conditions to support drilling access, pad design and earthworks planning.' },
			{ title: 'Geospatial planning automation suite', description: 'Developed GIS scripts that combined planning datasets, proposed drillholes and spatial assignment information.' },
			{
				title: 'AI-supported vertical drill-pad optimiser',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Vertical drillholes have no required pad azimuth, creating an opportunity to reduce earthworks cut-and-fill through orientation optimisation.'
					},
					{
						subtitle: 'Solution',
						description: 'Built an ArcGIS Pro Python toolbox testing hundreds of orientations against a DEM, then using aerial imagery and OpenAI to favour existing access tracks.'
					},
					{
						subtitle: 'Outcome',
						description: 'Used operationally, saving each project geologist approximately six hours per week while identifying practical, potentially lower-cost orientations.'
					}
				]
			}
		]
	},
	{
		year: '2026',
		entries: [
			{
				title: 'Multi-agent density drilling program designer',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Resource Definition received a substantial new workload designing density programs around model uncertainty, geological coverage, constraints and drilling cost.'
					},
					{
						subtitle: 'Solution',
						description: 'Built a web app using validated Vulcan geozones, heritage and land-use constraints, four specialist planning agents and a master agent; geologists retain veto control.'
					},
					{
						subtitle: 'Outcome',
						description: 'Still in testing, with implementation and validation incorporated into a project geologist’s FY27 KPI to progress it toward operational use.'
					}
				]
			},
			{ title: 'RC twin scoring model', description: 'Developed a traceable scoring concept for assessing possible RC twin holes and supporting density planning.' },
			{ title: 'AI governance and delivery framework', description: 'Established a structured portfolio of geoscience AI projects with clear ownership, testing and validation responsibilities.' },
			{
				title: 'Governed conversational geological analytics',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Geological data existed across many systems, while dashboards answered only predefined questions and cross-disciplinary analysis required technical support.'
					},
					{
						subtitle: 'Solution',
						description: 'Built a natural-language interface where MCP routes questions through domain semantic models and read-only SQL tools governed by each user’s existing permissions.'
					},
					{
						subtitle: 'Outcome',
						description: 'All semantic models are functioning with 25 trial users, including cross-system comparison of headcount and achieved drilling metres over two years.'
					}
				]
			},
			{ title: 'Operational-intelligence workflow', description: 'Combined activity, production, equipment and operator information to investigate operational performance and distinguish between allocation, task and equipment-related constraints.' },
			{ title: 'Governed cross-system data integration', description: 'Coordinated internal and external technical teams to establish a governed proof of concept for sharing operational data between systems.' },
			{ title: 'Multimodal geological QAQC', description: 'Developed a concept combining geological logging, structured QAQC information, comparison holes and core imagery within a conversational analysis workflow.' },
			{ title: 'Rapid internal application pilot', description: 'Participated in a pilot to test rapid development and deployment of lightweight internal applications against governed geoscience data.' },
			{
				title: 'Real-time AI-assisted geological data-quality monitoring',
				sections: [
					{
						subtitle: 'Problem',
						description: 'A significant error reached an external vendor meeting because data-quality detection still depended on reports and manual review.'
					},
					{
						subtitle: 'Solution',
						description: 'Built a Snowflake-stream workflow combining threshold and ML checks with Python, OpenAI, MCP context, Power Automate routing and an auditable notification archive.'
					},
					{
						subtitle: 'Outcome',
						description: 'Live for five notification types, it alerts within 15 seconds and has identified a genuine PLOD cost anomaly relative to metres and drilling hours.'
					}
				]
			},
			{ title: 'WhatsApp operational fault-pattern analysis', description: 'Analysed WhatsApp support conversations alongside equipment telemetry to identify recurring fault patterns, recognise early indicators of hardware and GNSS failure, and define practical automated monitoring rules.' }
		]
	}
];
---

<Layout
	title="Projects to date"
	description="A selected and anonymised record of technical, operational, geoscience AI, GIS, analytics and mining technology projects."
>
	<div class="site">
		<header>
			<nav>
				<a href="/">home</a>
				<span>/</span>
				<a href="/about">about</a>
				<span>/</span>
				<a href="/projects-to-date" aria-current="page">projects to date</a>
			</nav>
		</header>

		<main>
			<section class="intro">
				<h1>Projects to date</h1>
				<p>A selected and anonymised record of technical, operational and product work.</p>
			</section>

			<section class="timeline">
				{years.map((group) => (
					<section class="year-block">
						<h2>{group.year}</h2>
						<div class="year-entries">
							{'milestones' in group && (
								<aside class="career-progression">
									<p class="career-label">Career progression</p>
									{group.milestones.map((milestone) => (
										<div class="career-milestone">
											<p class="career-date">{milestone.date}</p>
											<h3>{milestone.title}</h3>
											<p>{milestone.description}</p>
										</div>
									))}
								</aside>
							)}
							{group.entries.map((entry) => (
								<article class="project-entry">
									<div class="marker" aria-hidden="true"></div>
									<div>
										<h3>{entry.title}</h3>
										{'sections' in entry ? (
											entry.sections.map((section) => (
												<div class="project-section">
													<h4>{section.subtitle}</h4>
													<p>{section.description}</p>
												</div>
											))
										) : (
											<p>{entry.description}</p>
										)}
									</div>
								</article>
							))}
						</div>
					</section>
				))}
			</section>
		</main>

		<footer>
			<a href="/">← back home</a>
		</footer>
	</div>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) {
		background: #000;
		color: #fff;
		font-family: "Courier New", Courier, monospace;
	}
	:global(body) { margin: 0; background: #000; }
	:global(a) {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.site {
		width: min(780px, calc(100% - 40px));
		min-height: 100vh;
		margin: 0 auto;
		padding: 24px 0 32px;
	}
	header {
		padding-bottom: 14px;
		border-bottom: 1px dashed #777;
	}
	nav {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		font-size: 15px;
	}
	main { padding: 48px 0; }
	.intro {
		padding-bottom: 34px;
		border-bottom: 1px dashed #777;
	}
	h1 { margin: 0 0 12px; font-size: 18px; }
	.intro p {
		margin: 0;
		color: #bbb;
		font-size: 15px;
		line-height: 1.6;
	}
	.timeline { padding-top: 42px; }
	.year-block {
		display: grid;
		grid-template-columns: 90px 1fr;
		gap: 28px;
		padding: 0 0 54px;
	}
	h2 {
		position: sticky;
		top: 24px;
		align-self: start;
		margin: 0;
		font-size: 16px;
	}
	.year-entries { position: relative; }
	.career-progression {
		margin: 0 0 34px 32px;
		padding: 16px 18px;
		border: 1px dashed #666;
	}
	.career-label {
		margin: 0 0 18px;
		color: #fff;
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.career-milestone + .career-milestone {
		margin-top: 20px;
		padding-top: 20px;
		border-top: 1px dashed #444;
	}
	.career-date {
		margin: 0 0 5px;
		color: #888;
		font-size: 12px;
	}
	.career-milestone h3 {
		margin-bottom: 6px;
	}
	.career-milestone > p:last-child {
		margin: 0;
		color: #aaa;
		font-size: 13px;
		line-height: 1.6;
	}
	.year-entries::before {
		content: "";
		position: absolute;
		top: 8px;
		bottom: 8px;
		left: 4px;
		border-left: 1px dashed #555;
	}
	.project-entry {
		position: relative;
		display: grid;
		grid-template-columns: 18px 1fr;
		gap: 14px;
		padding-bottom: 28px;
	}
	.marker {
		position: relative;
		z-index: 1;
		width: 9px;
		height: 9px;
		margin-top: 5px;
		background: #000;
		border: 1px solid #aaa;
		border-radius: 50%;
	}
	h3 {
		margin: 0 0 7px;
		font-size: 15px;
		line-height: 1.45;
	}
	.project-section {
		margin: 0 0 14px;
	}
	.project-section:first-of-type {
		margin-top: 14px;
	}
	.project-section:last-child {
		margin-bottom: 0;
	}
	.project-section h4 {
		margin: 0 0 4px;
		color: #ddd;
		font-size: 14px;
		font-weight: bold;
		line-height: 1.45;
	}
	.project-entry p {
		margin: 0;
		color: #aaa;
		font-size: 14px;
		line-height: 1.65;
	}
	footer {
		padding-top: 18px;
		border-top: 1px dashed #777;
		font-size: 15px;
	}
	@media (max-width: 620px) {
		.site { width: min(100% - 24px, 780px); }
		nav { justify-content: flex-start; flex-wrap: wrap; }
		.year-block { grid-template-columns: 1fr; gap: 18px; }
		h2 { position: static; }
		.career-progression { margin-left: 32px; }
	}
</style>
