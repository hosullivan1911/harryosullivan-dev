---
import Layout from '../layouts/Layout.astro';

const years = [
	{ year: '2023', entries: [
		{ title: 'Operational geology foundation', description: 'Learned metallurgical, geophysical, geotechnical and RC logging workflows using Acquire, Leapfrog, ArcGIS Pro and Tableau.' },
		{
			title: 'End-of-hole chart and assay review tool',
			sections: [
				{
					subtitle: 'Problem',
					description: 'The metallurgical stakeholders wanted core photography presented alongside assays and hole logging for every completed hole.'
				},
				{
					subtitle: 'Solution',
					description: 'Built an automated tool for producing end-of-hole charts and reviewing assay information. Incorporates and aligns photos, logging, assays and geophysics while accounting for differences between RC and diamond RLs.'
				},
				{
					subtitle: 'Outcome',
					description: 'Became the standard PDF output attached to completed-hole notifications, giving metallurgical stakeholders a consistent view of photography, logging, assays and geophysics. Approximately four holes are completed each week.'
				}
			]
		},
		{
			title: 'Downhole gamma and stratigraphic correlation calculator',
			sections: [
				{
					subtitle: 'Problem',
					description: 'A common part of the diamond QAQC process is validating logging intervals against a standard using the downhole gamma trace. This is time-consuming and can be very subjective.'
				},
				{
					subtitle: 'Solution',
					description: 'Used a simple regression model to compare the raw gamma trace against a converted standard, find the smallest error margin and validate that the standard boundaries aligned with the logging.'
				},
				{
					subtitle: 'Outcome',
					description: 'The standard was too noisy, and the gamma peak indicative of shale varied too much in scale between logs.'
				}
			]
		},
		{ title: 'Historical disturbance and rehabilitation assessment', description: 'Combined database records, maps and aerial imagery to assess historical drilling disturbance and rehabilitation status.' },
		{
			title: 'Drill-program cost forecasting model',
			sections: [
				{
					subtitle: 'Problem',
					description: 'CAPEX projects are billed to stakeholders internally; we had no way to estimate the cost of a program.'
				},
				{
					subtitle: 'Solution',
					description: 'Analysed historical drilling data and built a model that estimates drilling, personnel, flights, accommodation, fuel, earthworks and car or van rental costs relevant to exploration programs, while accounting for potential delays.'
				},
				{
					subtitle: 'Outcome',
					description: 'The Excel model was used for the remainder of the financial year before being superseded by an Anaplan-based tool.'
				}
			]
		}
	] },
	{ year: '2024', entries: [
		{
			title: 'Enterprise geological QAQC automation platform',
			sections: [
				{
					subtitle: 'Problem',
					description: 'QAQC in geological workflows can be highly subjective, and I noticed that the quality of data provided to stakeholders varied significantly.'
				},
				{
					subtitle: 'Solution',
					description: 'Consulted with our orebody specialist to define 20 strict logging rules: a set of non-negotiable data requirements. Initially built an Excel macro that applied these rules to uploaded CSV logging data and highlighted issues. This later transitioned into a Power BI report reading directly from Snowflake.'
				},
				{
					subtitle: 'Outcome',
					description: 'The tool was well received and remains in use. It has become an important part of senior geologists’ end-of-scope reporting.'
				}
			]
		},
		{ title: 'Sonic recovery and productivity analysis', description: 'Analysed recovery and production by geology, stratigraphy, shift, drilling method and ground conditions to distinguish operational performance from geological difficulty.' },
		{ title: 'Drilling-risk workflow', description: 'Created a spatial assessment workflow so planned holes could be checked against known underground hazards, specifically lost GET and cavities.' },
		{ title: 'Density-hole relocation analysis', description: 'Combined geological, assay and spatial constraints to identify technically suitable alternative drilling locations.' },
		{ title: 'Geological data integration into an enterprise platform', description: 'Worked with data teams to expose drilling, logging and operational information in Snowflake.' },
		{ title: 'Dynamic rig-scheduling tool', description: 'Developed and implemented a scheduling concept combining project priorities, expected drilling durations and available rig capacity.' },
		{
			title: 'PLOD and invoice reconciliation tool',
			sections: [
				{
					subtitle: 'Problem',
					description: 'I was tasked with comparing monthly drilling invoices against submitted PLODs (timesheets) and recommending whether each invoice should be accepted. This was time-consuming and prone to human error.'
				},
				{
					subtitle: 'Solution',
					description: 'Built a Python script that interpreted each drilling contractor’s invoice format and automatically reconciled claims against accepted PLOD data available through CorePlan.'
				},
				{
					subtitle: 'Outcome',
					description: 'Used the tool throughout my time in the team, and it continued to be used after I moved on. It has since been replaced by a more sophisticated integrated tool. However, issues remain because the source PLOD data depends on field teams accepting costs correctly, which does not always occur.'
				}
			]
		},
		{ title: 'ArcGIS pad-and-sump automation', description: 'Built an ArcGIS Pro Python toolbox that automated drilling pad and sump layouts and reduced repetitive GIS preparation. Generated the shapefiles required for the Trimble earthworks packages used at the time.' },
		{ title: 'Live project-completion reporting', description: 'Developed a reporting concept that progressively populated project-completion information from live operational and QAQC data.' },
		{ title: 'Tableau-to-Power BI transition', description: 'Contributed to the department-wide transition from Tableau to Power BI by building approximately 20 diamond-drilling reports.' }
	] },
	{
		year: '2025',
		milestones: [
			{
				date: 'March 2025',
				title: 'Systems Specialist Geologist secondment',
				description: 'Moved from field-based diamond drilling into a systems-focused secondment spanning geological data, automation, operational technology and AI.'
			},
			{
				date: 'September 2025',
				title: 'Permanent appointment offered',
				description: 'Following the secondment, Fortescue formalised the work into a permanent Systems Geologist role and offered it to me.'
			}
		],
		entries: [
			{
				title: 'GuidEx fleet deployment and operational intelligence',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Fortescue needed better visibility of earthworks assets operating in the field. The previous machine-guidance system did not provide sufficient positional accuracy, while operators needed a clearer in-cab view of permitted work areas and warnings near operational boundaries. When I assumed responsibility for GuidEx, hardware had been installed on approximately 10 of the intended 65 machines, and the supporting data, integration, support and analytical workflows were not yet established.'
					},
					{
						subtitle: 'Solution',
						description: 'Led deployment across 65 assets, five operational sites, four contracting companies and approximately 300 contractors. Managed installation logistics and troubleshooting, created a ServiceNow support workflow, contributed to GIS package generation, and built the Snowflake backend and applications required to ingest GuidEx logs. Developed an application for producing the SQLite pad-database component and led earthworks analysis by intersecting machine logs with pad and boundary geometries. The work later expanded into investigating Starlink connectivity and the business case for reducing physical flagging.'
					},
					{
						subtitle: 'Outcome',
						description: 'GuidEx was installed across all 65 assets and adopted across the five sites. It now provides operators with clearer spatial guidance and gives the business substantially improved visibility of field activity. Machine-generated data has also been reconciled against contractor-charged timesheets, enabling material cost recovery and creating a foundation for further connected-machine workflows and operational analytics.'
					}
				]
			},
			{
				title: 'AI-enabled drill-core image cataloguing',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Approximately 40,000 drill-core photographs were stored in OneDrive, making the archive slow to navigate, difficult to access consistently and unsuitable for systematic analysis. Metadata including hole ID, depth-from, depth-to and core loss was written on each tray rather than stored as structured data, leaving the photographs neither readily searchable nor AI-ready.'
					},
					{
						subtitle: 'Solution',
						description: 'Independently designed and built an automated image-cataloguing workflow. Tested conventional OCR and several AI models, then developed cropping, preprocessing and formatting logic to improve metadata extraction. Built the workflow for transferring new photographs automatically into the internal catalogue and incorporated an OpenAI-powered Python node to extract and structure metadata during ingestion. ServiceNow manages catalogue viewing and editing permissions.'
					},
					{
						subtitle: 'Outcome',
						description: 'Approximately 20,000 photographs have been uploaded into the catalogue, with metadata extraction achieving approximately 93% accuracy. New photographs now enter automatically, while a plan has been agreed with the site team for processing the remaining archive. The next stage is to use the extracted metadata to prepopulate selected fields in Acquire for geological review.'
					}
				]
			},
			{ title: 'Geoscience AI use-case portfolio', description: 'Identified and developed practical AI use cases across drilling, geology, earthworks, imagery and operational data.' },
			{ title: 'Terrain and drill-access analytics', description: 'Developed methods for classifying terrain and slope conditions to support drilling access, pad design and earthworks planning.' },
			{ title: 'Geospatial planning automation suite', description: 'Developed GIS scripts that combined planning datasets, proposed drillholes and spatial assignment information.' },
			{
				title: 'AI-supported vertical drill-pad optimiser',
				sections: [
					{
						subtitle: 'Problem',
						description: 'For vertical drillholes, the pad has no operationally required azimuth, creating an opportunity to reduce earthworks cut-and-fill volumes by optimising its orientation. Manually testing numerous orientations against terrain data was impractical and required considerable project-geologist time.'
					},
					{
						subtitle: 'Solution',
						description: 'Built an ArcGIS Pro Python toolbox that uses planned drillhole coordinates and a user-provided digital elevation model. The tool runs hundreds of possible pad orientations and compares their earthworks requirements to identify lower cut-and-fill candidates. It then uses aerial imagery and an OpenAI vision model to constrain the final candidates to orientations compatible with existing earthworks tracks. The method is deliberately limited to vertical holes, where pad orientation does not conflict with a required drilling azimuth.'
					},
					{
						subtitle: 'Outcome',
						description: 'The optimiser is used operationally and saves approximately six hours of manual work per week for each project geologist using it. It provides a repeatable method for identifying practical, potentially lower-cost pad orientations before construction planning begins.'
					}
				]
			}
		]
	},
	{
		year: '2026',
		entries: [
			{
				title: 'Multi-agent density drilling program designer',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Business stakeholders assigned Resource Definition a substantial new body of work: designing density drilling programs to address uncertainty within geological models. The programs needed to target geozones with insufficient density information while accounting for geological coverage, spatial variability, access constraints, heritage restrictions and drilling cost.'
					},
					{
						subtitle: 'Solution',
						description: 'Independently built a web application that queries validated, Vulcan-generated geozone data and lets the user identify parts of the model with the lowest density confidence. After applying heritage and land-use constraints, four specialist agents consider sample variability, geozone coverage, multi-zone drillhole opportunities and minimising the total number of holes. A fifth master agent evaluates their recommendations and produces a proposed program. Geologists can veto individual holes and rerun the workflow.'
					},
					{
						subtitle: 'Outcome',
						description: 'The application remains in testing, so operational savings have not yet been claimed. Implementation and further testing have been incorporated into a project geologist’s FY27 KPI, establishing formal ownership for progressing the workflow toward operational use.'
					}
				]
			},
			{ title: 'RC twin scoring model', description: 'Developed a traceable scoring concept for assessing possible RC twin holes and supporting density planning.' },
			{ title: 'AI governance and delivery framework', description: 'Established a structured portfolio of geoscience AI projects with clear ownership, testing and validation responsibilities.' },
			{
				title: 'Governed conversational geological analytics',
				sections: [
					{
						subtitle: 'Problem',
						description: 'Geological and operational data was available across assays, drillhole logs, geophysics, surveys, drilling activity, machine telemetry, photographs and field notes, but users still needed to locate the correct report, application or database table. Dashboards answered questions anticipated in advance, while new or cross-disciplinary questions required additional technical work.'
					},
					{
						subtitle: 'Solution',
						description: 'Developed a natural-language interface over governed datasets. An MCP layer routes each question to the relevant semantic model, including earthworks, drillhole collars, diamond geology, RC geology, geophysics and restricted commercial data. The semantic layer defines fields, relationships and terminology before generating SQL. Queries run through a read-only tool using the user’s existing permissions, and the results return to the AI for interpretation and presentation.'
					},
					{
						subtitle: 'Outcome',
						description: 'The functioning system includes all planned semantic models and is being trialled by 25 users. It has completed cross-domain analyses such as comparing changes in headcount with achieved drilling metres over the previous two years, allowing users to investigate questions that would otherwise require several reports or systems.'
					}
				]
			},
			{ title: 'Operational-intelligence workflow', description: 'Combined activity, production, equipment and operator information to investigate operational performance and distinguish between allocation, task and equipment-related constraints.' },
			{ title: 'Governed cross-system data integration', description: 'Coordinated internal and external technical teams to establish a governed proof of concept for sharing operational data between systems.' },
			{ title: 'Multimodal geological QAQC', description: 'Developed a concept combining geological logging, structured QAQC information, comparison holes and core imagery within a conversational analysis workflow.' },
			{ title: 'Rapid internal application pilot', description: 'Participated in a pilot to test rapid development and deployment of lightweight internal applications against governed geoscience data.' },
			{
				title: 'Real-time AI-assisted geological data-quality monitoring',
				sections: [
					{
						subtitle: 'Problem',
						description: 'A significant data error was discovered during a meeting with an external vendor. The existing process depended heavily on Power BI reports and site teams noticing problems manually, so a system was needed to screen incoming geological and operational data before errors reached downstream stakeholders.'
					},
					{
						subtitle: 'Solution',
						description: 'Independently built an event-driven workflow around Snowflake. Streams initiate deterministic threshold checks and machine-learning pattern recognition as new records arrive. Detected issues enter a pending-messages table, which a Python service checks every ten seconds. The service sends structured JSON to an OpenAI model, which produces a concise Teams-style message and can use an MCP interface to compare the issue with the wider governed dataset. Power Automate then routes the notification according to its classification, while an archive table records the result and delivery information.'
					},
					{
						subtitle: 'Outcome',
						description: 'The system is live for five notification types and delivers targeted alerts within approximately 15 seconds of data reaching Snowflake. Monitoring includes metres achieved per day, contractor-timesheet cost, missing PLOD data and GuidEx connection quality. It has already identified a genuine PLOD cost that was statistically unusual relative to metres drilled and drilling hours, shifting selected controls from retrospective review to near-real-time detection with an auditable history.'
					}
				]
			},
			{ title: 'WhatsApp operational fault-pattern analysis', description: 'Analysed WhatsApp support conversations alongside equipment telemetry to identify recurring fault patterns, recognise early indicators of hardware and GNSS failure, and define practical automated monitoring rules.' }
		]
	}
];
---

<Layout
	title="Projects to date"
	description="A selected and anonymised record of technical, operational, geoscience AI, GIS, analytics and mining technology projects."
>
	<div class="site">
		<header>
			<nav>
				<a href="/">home</a>
				<span>/</span>
				<a href="/about">about</a>
				<span>/</span>
				<a href="/projects-to-date" aria-current="page">projects to date</a>
			</nav>
		</header>

		<main>
			<section class="intro">
				<h1>Projects to date</h1>
				<p>A selected and anonymised record of technical, operational and product work.</p>
			</section>

			<section class="timeline">
				{years.map((group) => (
					<section class="year-block">
						<h2>{group.year}</h2>
						<div class="year-entries">
							{'milestones' in group && (
								<aside class="career-progression">
									<p class="career-label">Career progression</p>
									{group.milestones.map((milestone) => (
										<div class="career-milestone">
											<p class="career-date">{milestone.date}</p>
											<h3>{milestone.title}</h3>
											<p>{milestone.description}</p>
										</div>
									))}
								</aside>
							)}
							{group.entries.map((entry) => (
								<article class="project-entry">
									<div class="marker" aria-hidden="true"></div>
									<div>
										<h3>{entry.title}</h3>
										{'sections' in entry ? (
											entry.sections.map((section) => (
												<div class="project-section">
													<h4>{section.subtitle}</h4>
													<p>{section.description}</p>
												</div>
											))
										) : (
											<p>{entry.description}</p>
										)}
									</div>
								</article>
							))}
						</div>
					</section>
				))}
			</section>
		</main>

		<footer>
			<a href="/">← back home</a>
		</footer>
	</div>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) {
		background: #000;
		color: #fff;
		font-family: "Courier New", Courier, monospace;
	}
	:global(body) { margin: 0; background: #000; }
	:global(a) {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.site {
		width: min(780px, calc(100% - 40px));
		min-height: 100vh;
		margin: 0 auto;
		padding: 24px 0 32px;
	}
	header {
		padding-bottom: 14px;
		border-bottom: 1px dashed #777;
	}
	nav {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		font-size: 15px;
	}
	main { padding: 48px 0; }
	.intro {
		padding-bottom: 34px;
		border-bottom: 1px dashed #777;
	}
	h1 { margin: 0 0 12px; font-size: 18px; }
	.intro p {
		margin: 0;
		color: #bbb;
		font-size: 15px;
		line-height: 1.6;
	}
	.timeline { padding-top: 42px; }
	.year-block {
		display: grid;
		grid-template-columns: 90px 1fr;
		gap: 28px;
		padding: 0 0 54px;
	}
	h2 {
		position: sticky;
		top: 24px;
		align-self: start;
		margin: 0;
		font-size: 16px;
	}
	.year-entries { position: relative; }
	.career-progression {
		margin: 0 0 34px 32px;
		padding: 16px 18px;
		border: 1px dashed #666;
	}
	.career-label {
		margin: 0 0 18px;
		color: #fff;
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.career-milestone + .career-milestone {
		margin-top: 20px;
		padding-top: 20px;
		border-top: 1px dashed #444;
	}
	.career-date {
		margin: 0 0 5px;
		color: #888;
		font-size: 12px;
	}
	.career-milestone h3 {
		margin-bottom: 6px;
	}
	.career-milestone > p:last-child {
		margin: 0;
		color: #aaa;
		font-size: 13px;
		line-height: 1.6;
	}
	.year-entries::before {
		content: "";
		position: absolute;
		top: 8px;
		bottom: 8px;
		left: 4px;
		border-left: 1px dashed #555;
	}
	.project-entry {
		position: relative;
		display: grid;
		grid-template-columns: 18px 1fr;
		gap: 14px;
		padding-bottom: 28px;
	}
	.marker {
		position: relative;
		z-index: 1;
		width: 9px;
		height: 9px;
		margin-top: 5px;
		background: #000;
		border: 1px solid #aaa;
		border-radius: 50%;
	}
	h3 {
		margin: 0 0 7px;
		font-size: 15px;
		line-height: 1.45;
	}
	.project-section {
		margin: 0 0 14px;
	}
	.project-section:first-of-type {
		margin-top: 14px;
	}
	.project-section:last-child {
		margin-bottom: 0;
	}
	.project-section h4 {
		margin: 0 0 4px;
		color: #ddd;
		font-size: 14px;
		font-weight: bold;
		line-height: 1.45;
	}
	.project-entry p {
		margin: 0;
		color: #aaa;
		font-size: 14px;
		line-height: 1.65;
	}
	footer {
		padding-top: 18px;
		border-top: 1px dashed #777;
		font-size: 15px;
	}
	@media (max-width: 620px) {
		.site { width: min(100% - 24px, 780px); }
		nav { justify-content: flex-start; flex-wrap: wrap; }
		.year-block { grid-template-columns: 1fr; gap: 18px; }
		h2 { position: static; }
		.career-progression { margin-left: 32px; }
	}
</style>
